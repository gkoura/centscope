// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String
  emailVerified            Boolean             @default(false)
  image                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  ownedFinancialAccounts   FinancialAccount[]  @relation("FinancialAccountOwner")
  createdFinancialAccounts FinancialAccount[]  @relation("FinancialAccountCreator")
  sentAccountInvitations   AccountInvitation[]
  financialMemberships     AccountMembership[]
  wallets                  Wallet[]
  transactions             Transaction[]
  recurrenceRules          RecurrenceRule[]
  transactionChanges       TransactionChange[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// See prisma/SCHEMA_NOTES.md for database checks and activated features.
// Domain money uses exact Decimal values. Round to each currency's minor units.
// No balance cache: sum LedgerEntry.amount where transaction.status = POSTED.

enum AccountRole {
  COLLABORATOR
  VIEWER
}

enum WalletType {
  BANK
  CASH
  OTHER
}

enum TransactionStatus {
  PENDING
  POSTED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model FinancialAccount {
  // Shared visual identity; supported palette keys are enforced by a database CHECK.
  theme              String              @default("forest") @db.VarChar(16)
  sortOrder          Int                 @default(0)
  id                 String              @id @default(cuid())
  name               String
  // Owner is stored once, separate from non-owner memberships.
  ownerId            String
  owner              User                @relation("FinancialAccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User                @relation("FinancialAccountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  // Conversion/display currency only; wallets can use other currencies.
  reportingCurrency  String              @db.VarChar(3)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  invitations        AccountInvitation[]
  memberships        AccountMembership[]
  wallets            AccountWallet[]
  categories         Category[]
  budgetCadenceOrder String[]            @default(["DAILY", "WEEKLY", "MONTHLY", "YEARLY"])
  recurringBudgets   RecurringBudget[]

  @@index([ownerId])
  @@index([createdById])
  @@index([ownerId, sortOrder])
  @@map("financial_account")
}

model AccountMembership {
  financialAccountId String
  userId             String
  role               AccountRole
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@id([financialAccountId, userId])
  @@index([userId])
  @@map("account_membership")
}

model AccountInvitation {
  id                 String           @id @default(cuid())
  financialAccountId String
  email              String
  role               AccountRole
  tokenHash          String           @unique
  invitedById        String
  expiresAt          DateTime         @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  invitedBy          User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([financialAccountId, email])
  @@map("account_invitation")
}

model Wallet {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  type        WalletType
  // ISO 4217; immutable after first financial movement.
  currency    String          @db.VarChar(3)
  archivedAt  DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  allocations AccountWallet[]

  @@index([ownerId])
  @@map("wallet")
}

model AccountWallet {
  sortOrder             Int              @default(0)
  id                    String           @id @default(cuid())
  financialAccountId    String
  walletId              String
  financialAccount      FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  wallet                Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  archivedAt            DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  entries               LedgerEntry[]
  recurringSources      RecurrenceRule[] @relation("RecurringSource")
  recurringDestinations RecurrenceRule[] @relation("RecurringDestination")

  @@unique([id, financialAccountId])
  @@unique([financialAccountId, walletId])
  @@index([walletId])
  @@index([financialAccountId, sortOrder])
  @@map("account_wallet")
}

model Category {
  sortOrder          Int                       @default(0)
  id                 String                    @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  name               String
  type               CategoryType
  parentId           String?
  // Composite FK prevents a subcategory from belonging to another account.
  parent             Category?                 @relation("CategoryHierarchy", fields: [parentId, financialAccountId], references: [id, financialAccountId], onDelete: Restrict, onUpdate: NoAction)
  children           Category[]                @relation("CategoryHierarchy")
  archivedAt         DateTime?                 @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  entries            LedgerEntry[]
  recurrenceRules    RecurrenceRule[]
  budgetSelections   RecurringBudgetCategory[]

  @@unique([id, financialAccountId])
  @@index([financialAccountId, type])
  @@index([parentId, financialAccountId])
  @@index([financialAccountId, type, parentId, sortOrder])
  @@map("category")
}

model Transaction {
  id             String                @id @default(cuid())
  type           TransactionType
  // Explicit choice, never inferred or automatically changed from date.
  status         TransactionStatus
  name           String
  notes          String?               @db.Text
  occurredAt     DateTime              @db.Timestamptz(3)
  createdById    String
  createdBy      User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Scoped to creator; optional for manually created transactions.
  idempotencyKey String?
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  expenseSpread  ExpenseSpread?
  entries        LedgerEntry[]
  occurrence     RecurrenceOccurrence?
  changes        TransactionChange[]

  @@unique([createdById, idempotencyKey])
  @@index([status, occurredAt])
  @@index([createdById, occurredAt])
  @@map("transaction")
}

model ExpenseSpread {
  transactionId String      @id
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  startMonth    String      @db.VarChar(7)
  monthCount    Int

  @@index([startMonth])
  @@map("expense_spread")
}

model LedgerEntry {
  id                 String        @id @default(cuid())
  transactionId      String
  transaction        Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountWalletId    String
  financialAccountId String
  accountWallet      AccountWallet @relation(fields: [accountWalletId, financialAccountId], references: [id, financialAccountId], onDelete: Restrict)
  // Signed amount in the wallet currency: outgoing negative, incoming positive.
  amount             Decimal       @db.Decimal(24, 8)
  // Select either root category or subcategory; parent is derived, not duplicated.
  categoryId         String?
  category           Category?     @relation(fields: [categoryId, financialAccountId], references: [id, financialAccountId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([transactionId, accountWalletId])
  @@index([accountWalletId])
  @@index([categoryId, financialAccountId])
  @@map("ledger_entry")
}

model RecurrenceRule {
  id                String                 @id @default(cuid())
  createdById       String
  createdBy         User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Template: EXPENSE, INCOME or TRANSFER only. Amounts are positive.
  type              TransactionType
  name              String
  notes             String?                @db.Text
  sourceId          String
  source            AccountWallet          @relation("RecurringSource", fields: [sourceId], references: [id], onDelete: Restrict)
  destinationId     String?
  destination       AccountWallet?         @relation("RecurringDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  amount            Decimal                @db.Decimal(24, 8)
  // Required for cross-currency transfer templates; actual amount confirmed at posting.
  destinationAmount Decimal?               @db.Decimal(24, 8)
  categoryId        String?
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Legacy preference retained for compatibility; additional copies are always PENDING.
  endAfter          Int?
  nextIndex         Int                    @default(1)
  version           Int                    @default(1)
  stoppedAt         DateTime?              @db.Timestamptz(3)
  spreadMonthCount  Int?
  spreadMonthOffset Int                    @default(0)
  occurrenceStatus  TransactionStatus      @default(PENDING)
  frequency         RecurrenceFrequency
  interval          Int                    @default(1)
  timezone          String
  startsAt          DateTime               @db.Timestamptz(3)
  endsAt            DateTime?              @db.Timestamptz(3)
  nextOccurrenceAt  DateTime?              @db.Timestamptz(3)
  pausedAt          DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  occurrences       RecurrenceOccurrence[]

  @@index([createdById])
  @@index([pausedAt, nextOccurrenceAt])
  @@index([sourceId])
  @@index([destinationId])
  @@index([categoryId])
  @@map("recurrence_rule")
}

model RecurrenceOccurrence {
  id            String         @id @default(cuid())
  ruleId        String
  rule          RecurrenceRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  // Stable original slot, even if the user later changes the transaction date.
  scheduledFor  DateTime       @db.Timestamptz(3)
  transactionId String?        @unique
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  // Retain this row after deletion/skipping to prevent regeneration.
  skippedAt     DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([ruleId, scheduledFor])
  @@map("recurrence_occurrence")
}

// Append-only service policy; snapshot contains domain data only, never auth secrets.
// Intentionally survives transaction deletion; transactionId is an audit identifier.
model TransactionChange {
  id                String       @id @default(cuid())
  transactionId     String
  // Optional live reference is cleared on deletion, preserving the audit identifier.
  liveTransactionId String?
  transaction       Transaction? @relation(fields: [liveTransactionId], references: [id], onDelete: SetNull)
  actorId           String
  actor             User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action            String
  snapshot          Json
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([transactionId, createdAt])
  @@index([liveTransactionId])
  @@index([actorId])
  @@map("transaction_change")
}

// One account-scoped plan, evaluated independently in each calendar recurrence period.
model RecurringBudget {
  sortOrder            Int                       @default(0)
  id                   String                    @id @default(cuid())
  financialAccountId   String
  financialAccount     FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  allCategories        Boolean                   @default(true)
  includeUncategorized Boolean                   @default(false)
  categorySelections   RecurringBudgetCategory[]
  name                 String                    @db.VarChar(80)
  recurrence           RecurrenceFrequency       @default(MONTHLY)
  currency             String                    @db.VarChar(3)
  spendingLimit        Decimal                   @db.Decimal(24, 8)
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([id, financialAccountId])
  @@index([financialAccountId, recurrence, sortOrder])
  @@map("recurring_budget")
}

model RecurringBudgetCategory {
  budgetId           String
  financialAccountId String
  categoryId         String
  includeChildren    Boolean         @default(false)
  budget             RecurringBudget @relation(fields: [budgetId, financialAccountId], references: [id, financialAccountId], onDelete: Cascade)
  category           Category        @relation(fields: [categoryId, financialAccountId], references: [id, financialAccountId], onDelete: Restrict, onUpdate: NoAction)

  @@id([budgetId, categoryId])
  @@index([categoryId, financialAccountId])
  @@map("recurring_budget_category")
}
